{
  "name": "ns-exam-portal",
  "private": true,
  "version": "0.0.0",
  "description": "NS Exam Portal - Comprehensive online examination platform",
  "author": "NS Software Solutions",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "npm-run-all --parallel dev:backend dev",
    "build": "cd frontend && npm run build",
    "build:dev": "cd frontend && npm run build:dev",
    "lint": "cd frontend && npm run lint",
    "preview": "cd frontend && npm run preview"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
